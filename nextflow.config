nextflow.enable.dsl=2

manifest {
    name = 'NenuFlow'
    author = 'Kariuki Chege (jameskariuki31@gmail.com)'
    description = 'LEAP3'
    defaultBranch = 'dev'
    version = '1.0.0'
}

singularity.enabled = true

process {
  withLabel: 'default' {
    container = null
  }

  withLabel: 'sing' {
   container = "/home/codex/chege/software/containers/dawntools-2024-10-16.sif"
   containerOptions = '--bind /net,/home,/data'
  }
}


params {

    stagelib = "/home/codex/chege/software/pipelines/twoleap/stages.nf"

    data {

        path = null
        nodes = null
        hosts = 'hosts.txt'
        label = 'nxt24'
        bp_subbands_per_node = null
        


        // These are glob patterns
        ms_files {
            raw = null
            raw_compressed = null
            bp = null
            di = null
            di_b = null //txtfile with the timechunks of each SB after DI-smooth channel split
            dd = null
        }

        raw_mslist="raw_mses.txt"
        bp_mslist="bp_mses.txt"
        di_mslist="di_mses.txt"
        dd_mslist="dd_mses.txt"
    }

    average {
        nchans_per_subband_after_averaging  = 3

        lta_to_di {
            freqstep = 5
            timestep = 1
            msout = null
            column = 'DATA'
        }

        ditodd {
            freqstep = 1
            timestep = 5
            msout = null
        }
    }

    split {
        mses_per_node = null
        nodes=null
        di {
            ntimes=300
            ms_prefix = null
        }
        dd {
            ntimes=30
            ms_prefix = null
        }
    }

    ddecal {

        di {

            parset = "/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/di.parset"
            sourcedb = "/home/codex/chege/software/pipelines/twoleap/models/rescaled_new3c61.sky.txt"
            sols = "di_solutions.h5"
            incol = 'DATA'
            outcol = 'DI_CORRECTED'
            solint = 15
            uvlambdamin = 50
            uvlambdamax = 5000
            nchan = 3

            apply {
                parset="/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/di_apply.parset"
            }
        }

        bp {
            parset = "/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/bp.parset"
            sourcedb = "/home/codex/chege/software/pipelines/twoleap/models/rescaled_new3c61.sky.txt"
            sols = "bp_solutions.h5"
            incol = 'DATA'
            outcol = 'BP_CORRECTED'
            solint = 0
            uvlambdamin = 50
            uvlambdamax = 5000
            nchan = 3

            apply {
                parset = "/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/bp_apply.parset"
            }

        }

        beam {
            outcol = "BP_BEAM_CORRECTED"
            parset = "/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/beam_apply.parset"
        }

        ateams {
            parset = "/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/ateams/ateams.parset"
            sourcedb = "/home/codex/chege/software/pipelines/twoleap/models/ateam_plus_rescaled_new3c61.sky.txt"
            sols = "ateam_solutions.h5"
            incol = 'DATA'
            outcol = 'ATEAM_SUBTRACTED'
            solint=30
            uvlambdamin = 250
            uvlambdamax = 5000
            nchan = 3

            subtract {
                parset="/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/ateams/ateams_subtract.parset"
                clusters="/home/codex/chege/software/pipelines/twoleap/models/ateam_clusters_to_subtract.txt"
            }
        }

        dd {
            parset = "/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/dd.parset"
            sourcedb = "/home/codex/chege/software/pipelines/twoleap/models/sky_sagecal_no_diffuse_simple_ateam_corrected_shape.bbs.txt"
            sols = "dd_solutions.h5"
            incol = "DATA"
            outcol = "DD_CORRECTED"
            solint = 60
            uvlambdamin = 250
            uvlambdamax = 5000
            nchan = 3

            bpol=3

            subtract {
                parset="/home/codex/chege/software/pipelines/twoleap/parsets/ddecal/dd_subtract.parset"
                clusters="/home/codex/chege/software/pipelines/twoleap/models/dd_clusters_to_subtract.txt"
            }

        }
    }

    dysco {
        nbits=10
        normalization="RF"
        distribution="TruncatedGaussian"   
        disttruncation=2.5
    }

    wsclean {
        size = 900
        scale = '2amin'
        polfit = 2
        niter=0
        pol='I'
        chansout=69
        minuvl=50
        maxuvl=300
        weight="briggs -0.1"
        imname=null
        column=null
        chansout_per_timechunk=null
        chansout_per_subband=1
    }

    pspipe {
        dir="ps"
        obsid=null
        revision= "rev001"
        max_concurrent = 150
        merge_ms=false
        aoflag_after_merge_ms=false
        delay_flagger=false
        vis_flagger=false
        gpr=false
        ml_gpr = true
    }

    out {
        logs = "logs"
        results="results"
    }

}

dag {
    enabled = true
    overwrite=true
}

report {
    enabled = true
    overwrite=true
}

timeline {
    enabled = true
    overwrite=true
}

trace {
    enabled = true
    overwrite=true
}